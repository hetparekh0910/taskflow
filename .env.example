# Copy to .env (docker compose reads it) and adjust. Nothing here is required for a local demo.
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=0
ALLOWED_HOSTS=localhost,127.0.0.1
POSTGRES_PASSWORD=taskflow

# URL users open in the browser (used in emails + Stripe redirects)
FRONTEND_URL=http://localhost:8080
CSRF_TRUSTED_ORIGINS=http://localhost:8080
# Only needed if the frontend is served from a different origin than the API (e.g. Vercel + Render)
CORS_ALLOWED_ORIGINS=http://localhost:8080
# CORS_ORIGIN_REGEX=^https://.*\.vercel\.app$

# --- Billing: leave STRIPE_SECRET_KEY empty to use the built-in simulated checkout ----------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_PRICE_BUSINESS=

# --- Email: console backend prints emails to the logs. For real email use SMTP. ------------------
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.example.com
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# DEFAULT_FROM_EMAIL=TaskFlow <noreply@yourdomain.com>
